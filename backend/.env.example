# Environment Configuration for AI-Driven Fraud Detection and Prevention System
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./fraud_detection.db

# JWT & Security Secret (for production, use a strong 256-bit random key)
SECRET_KEY=super-secret-fraud-detection-security-key-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ML Model Configuration
MODEL_DIR=app/ml/model_artifacts
FRAUD_PROBABILITY_THRESHOLD_SUSPICIOUS=0.30
FRAUD_PROBABILITY_THRESHOLD_HIGH_RISK=0.60
ANOMALY_SCORE_THRESHOLD=0.65

# Frontend CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
